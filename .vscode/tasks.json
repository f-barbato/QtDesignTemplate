{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure QtDesignTemplate",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset", "debug-local"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build QtDesignTemplate",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "--preset", "debug-local",
                "--target", "QtDesignTemplateApp"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "Configure QtDesignTemplate",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        }
    ]
}
